{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Write|Edit",
          "hooks": [
            {
              "type": "process",
              "command": "node",
              "args": ["<ABS_PATH>/zcode/hooks/guard-protected.mjs"],
              "timeoutMs": 8000
            }
          ]
        },
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "process",
              "command": "node",
              "args": ["<ABS_PATH>/zcode/hooks/guard-protected.mjs"],
              "timeoutMs": 8000
            }
          ]
        }
      ]
    }
  }
}
